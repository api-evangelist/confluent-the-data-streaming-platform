              }
            ]
          },
          "docs": "Get an API key"
        },
        {
          "info": {
            "name": "Delete an API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.confluent.cloud/iam/v2/api-keys/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an API key"
        }
      ]
